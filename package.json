{
  "name": "racerhistory-admin-js",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@babel/preset-env": "^7.22.9",
    "@hotwired/stimulus": "^3.2.2",
    "@playwright/test": "^1.58.2",
    "axe-core": "^4.10.3",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "canvas": "^2.11.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^62.9.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdoc": "^4.0.5",
    "jsdom": "^24.0.0",
    "prettier": "^3.5.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^37.0.0",
    "vite": "^5.4.21"
  },
  "scripts": {
    "dev": "vite",
    "dev:clean": "npm run clean:vite-cache && vite --force",
    "build": "vite build",
    "build:clean": "npm run clean:dist && vite build",
    "clean:dist": "node -e \"const fs=require('fs');['webroot/dist/assets','webroot/dist/manifest.json'].forEach((p)=>fs.rmSync(p,{recursive:true,force:true}));\"",
    "clean:vite-cache": "node -e \"const fs=require('fs');fs.rmSync('node_modules/.vite',{recursive:true,force:true});\"",
    "preview": "vite preview",
    "test:js": "cross-env jest --env=jsdom --colors",
    "test:js:esm": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --env=jsdom --colors",
    "test:js:watch": "jest --env=jsdom --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "playwright:install": "playwright install --with-deps chromium",
    "lint:js": "npx eslint 'js/**' --max-warnings=0",
    "lint:js:fix": "npx eslint 'js/**' --fix",
    "lint:css": "npx stylelint 'webroot/css/**/*.css'",
    "format:js": "npx prettier --write js",
    "format:js:check": "npx prettier --check js"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ],
    "sourceType": "unambiguous"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "injectGlobals": true,
    "transform": {
      "^.+\\.(js|mjs)$": "babel-jest"
    },
    "moduleFileExtensions": [
      "js",
      "mjs",
      "json"
    ],
    "testMatch": [
      "**/js/tests/**/*.test.js",
      "**/js/tests/**/*.test.mjs"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "js/**/*.js",
      "js/**/*.mjs",
      "!js/tests/**",
      "!webroot/js/tinymce/**",
      "!vendor/**"
    ],
    "coverageDirectory": "coverage-js",
    "coverageReporters": [
      "clover",
      "lcov",
      "text-summary"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/vendor/",
      "<rootDir>/e2e/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/vendor/"
    ],
    "coveragePathIgnorePatterns": [
      "/vendor/",
      "/js/tests/",
      "/webroot/js/tinymce/",
      "/e2e/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "canvas": "<rootDir>/__mocks__/canvas.js",
      "^@hotwired/turbo$": "<rootDir>/js/__mocks__/@hotwired/turbo.js",
      "\\.css$": "<rootDir>/js/__mocks__/styleMock.js"
    }
  },
  "overrides": {
    "tar": "^7.5.11"
  },
  "dependencies": {
    "@hotwired/turbo": "^8.0.23",
    "admin-lte": "^4.0.2",
    "bootstrap": "^5.3.2",
    "datatables.net": "^1.13.11",
    "datatables.net-bs5": "^1.13.11",
    "datatables.net-buttons": "^2.4.2",
    "datatables.net-buttons-bs5": "^2.4.2",
    "datatables.net-datetime": "^1.6.3",
    "datatables.net-responsive": "^2.4.1",
    "datatables.net-responsive-bs5": "^2.4.1",
    "datatables.net-scroller": "^2.3.0",
    "datatables.net-scroller-bs5": "^2.3.0",
    "datatables.net-searchbuilder": "^1.4.2",
    "datatables.net-searchbuilder-bs5": "^1.4.2",
    "jquery": "^3.7.1",
    "luxon": "^3.7.2"
  }
}
