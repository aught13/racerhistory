#!/usr/bin/env bash
set -euo pipefail

# Ensure we run from the repo root
ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

# If PHPStan isn't installed, skip gracefully
if [ ! -x "vendor/bin/phpstan" ]; then
  echo "[pre-commit] vendor/bin/phpstan not found; skipping PHPStan check"
  exit 0
fi

PHP_BIN="${PHP:-php}"

echo "[pre-commit] Running PHPStan with increased memory..."

# Force higher PHP memory for the process and pass PHPStan's own memory flag as well
"$PHP_BIN" -d memory_limit=1G vendor/bin/phpstan analyse \
  --configuration=phpstan.neon \
  --no-progress \
  --memory-limit=1G

echo "[pre-commit] PHPStan OK"

# Run PHPCS to ensure coding standards compliance
if [ -x "vendor/bin/phpcs" ]; then
  echo "[pre-commit] Running PHPCS..."
  if ! vendor/bin/phpcs --standard=phpcs.xml src/ tests/; then
    echo "[pre-commit] PHPCS failed. Run 'vendor/bin/phpcbf --standard=phpcs.xml src/ tests/' to auto-fix issues." >&2
    exit 1
  fi
  echo "[pre-commit] PHPCS OK"
else
  echo "[pre-commit] vendor/bin/phpcs not found; skipping PHPCS"
fi

# Run Jest to ensure JavaScript tests pass
if command -v npx >/dev/null 2>&1 && [ -f "package.json" ]; then
  echo "[pre-commit] Running Jest..."
  if ! npx jest --passWithNoTests; then
    echo "[pre-commit] Jest failed. Fix JavaScript tests before committing." >&2
    exit 1
  fi
  echo "[pre-commit] Jest OK"
else
  echo "[pre-commit] Jest not available; skipping JavaScript tests"
fi

# Run PHPUnit to ensure the PHP test suite passes before committing
if [ -x "vendor/bin/phpunit" ]; then
  echo "[pre-commit] Running PHPUnit..."
  if ! vendor/bin/phpunit; then
    echo "[pre-commit] PHPUnit failed. Aborting commit." >&2
    exit 1
  fi
  echo "[pre-commit] PHPUnit OK"
else
  echo "[pre-commit] vendor/bin/phpunit not found; skipping PHPUnit"
fi

echo "[pre-commit] All checks passed!"
exit 0
