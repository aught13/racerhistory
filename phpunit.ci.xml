<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true">
    <!-- NOTE: Using PHPUnit 10.x compatible schema and coverage configuration.
        For PHPUnit 11/12 the coverage <report> format remains backward compatible.
        If upgrading schema, ensure the <coverage><report> placement matches the target version.
    -->
    <php>
        <ini name="memory_limit" value="-1"/>
        <ini name="apc.enable_cli" value="1"/>
        <env name="XDEBUG_MODE" value="coverage"/>
    </php>
    <testsuites>
        <testsuite name="app">
            <directory suffix="Test.php">tests/TestCase</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
            <directory suffix=".php">plugins/*/src</directory>
        </include>
        <exclude>
            <file>src/Console/Installer.php</file>
            <directory>src/Console</directory>
        </exclude>
    </source>
    <coverage>
        <report>
            <clover outputFile="coverage.xml"/>
            <html outputDirectory="tmp/coverage"/>
        </report>
    </coverage>
    <logging>
        <junit outputFile="test-results.xml"/>
    </logging>
</phpunit>
